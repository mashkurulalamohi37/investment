# Swapnojatri Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="Swapnojatri Investment Platform API"
API_V1_STR="/api/v1"
PROJECT_TIMEZONE="Asia/Dhaka"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Tokens
SECRET_KEY=change_this_to_a_secure_64_byte_random_string_in_production_9821
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=swapnojatri_user
POSTGRES_PASSWORD=swapnojatri_secure_pass_2026
POSTGRES_DB=swapnojatri_db
DATABASE_URL=postgresql+asyncpg://swapnojatri_user:swapnojatri_secure_pass_2026@localhost:5432/swapnojatri_db
SYNC_DATABASE_URL=postgresql+psycopg2://swapnojatri_user:swapnojatri_secure_pass_2026@localhost:5432/swapnojatri_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Celery Worker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_PUBLIC=swapnojatri-public-assets
S3_BUCKET_PRIVATE=swapnojatri-private-vault
S3_BUCKET_REPORTS=swapnojatri-reports
S3_REGION=ap-southeast-1

# EPS Payment Gateway Config
EPS_MERCHANT_ID=EPS_MERCHANT_SWAPNOJATRI_01
EPS_STORE_ID=STORE_SWAPNOJATRI_MAIN
EPS_APP_SECRET=eps_sec_k98a21f7e02b8429910d
EPS_IS_SANDBOX=true
EPS_SANDBOX_URL=https://sandbox.epay.com.bd/api/v1
EPS_LIVE_URL=https://api.epay.com.bd/api/v1

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:8000","https://swapnojatri.com"]

# Sentry DSN (Optional)
SENTRY_DSN=
